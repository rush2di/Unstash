{
  "expo": {
    "name": "RemindMe",
    "slug": "remindme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remindme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.remindme.app.saves",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram"
        ]
      },
      "appleTeamId": "D8H38Z425L"
    },
    "android": {
      "package": "com.remindme.app.saves",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "./plugins/without-push-entitlement",
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "RemindMe Share",
          "androidIntentFilters": [
            "text/*"
          ],
          "iosAppGroup": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "RemindMeShare",
                  "bundleIdentifier": "com.remindme.app.saves.share-extension"
                }
              ]
            }
          }
        },
        "projectId": "2524bb2e-4c11-45a9-8210-26de63d82867"
      }
    },
    "owner": "rochdi25"
  }
}
