# Copy to .env and fill in. `.env` is git-ignored.

# Exabase link preview API key (https://exabase.io) — the primary preview source.
# Server-side only. Never use the EXPO_PUBLIC_ prefix for this: that would inline the
# secret into the app bundle, where anyone can extract it.
#
# Leave it empty and the resolver falls back to reading Instagram's public Open Graph
# tags, which also works.
EXABASE_API_KEY=

# Base URL the app uses to reach the /api/instagram/preview route.
#   local web + simulator : http://localhost:8081
#   physical device       : http://<your-LAN-ip>:8081
#   deployed              : your EAS Hosting URL
#
# Leave it unset and the app still works: saved items keep the "Preview unavailable"
# state, which is a designed state rather than an error.
EXPO_PUBLIC_PREVIEW_API_URL=
